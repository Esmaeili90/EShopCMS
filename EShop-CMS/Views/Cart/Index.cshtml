@model EShop_CMS.DataBase.ViewModel.CartViewModel
@{
    ViewBag.title = "Shopping Cart";
}

<style>
  .cart-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 32px 24px 60px 24px;
  }

  .cart-heading {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .cart-subtitle {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 24px;
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 24px;
    align-items: start;
  }

  .cart-items-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .cart-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
  }

  .cart-item:last-child { border-bottom: none; }

  .cart-item-thumb {
    width: 72px;
    height: 72px;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(135deg, #EEF2FF, #F7F8FA);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 11px;
    flex-shrink: 0;
  }

  .cart-item-thumb img { width: 100%; height: 100%; object-fit: cover; }

  .cart-item-info { flex: 1; min-width: 0; }

  .cart-item-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .cart-item-price {
    font-size: 13px;
    color: var(--muted);
  }

  .cart-item-badge {
    display: inline-block;
    margin-top: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    background: var(--no-bg);
    color: var(--no-text);
  }

  .cart-item-qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .cart-item-qty button {
    width: 32px;
    height: 32px;
    border: none;
    background: var(--surface);
    font-size: 15px;
    cursor: pointer;
  }

  .cart-item-qty button:hover { background: var(--bg); }

  .cart-item-qty input {
    width: 38px;
    height: 32px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    font-size: 13px;
  }

  .cart-item-subtotal {
    width: 100px;
    text-align: right;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .cart-item-remove {
    background: none;
    border: none;
    color: var(--no-text);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
  }

  .cart-item-remove:hover { text-decoration: underline; }

  .cart-summary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 20px;
    position: sticky;
    top: 90px;
  }

  .cart-summary-card h3 {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .summary-row.total {
    color: var(--text);
    font-weight: 700;
    font-size: 15px;
    border-top: 1px solid var(--border);
    padding-top: 12px;
    margin-top: 12px;
  }

  .checkout-btn {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--accent);
    color: white;
    border: none;
    text-decoration: none;
    border-radius: 8px;
    padding: 12px 0;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 16px;
  }

  .checkout-btn:hover { background: var(--accent-dark); }

  .continue-link {
    display: block;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    margin-top: 12px;
  }

  .continue-link:hover { color: var(--accent); }

  .empty-cart {
    text-align: center;
    padding: 60px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .empty-cart .icon { font-size: 40px; margin-bottom: 12px; }
  .empty-cart h3 { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
  .empty-cart p { color: var(--muted); font-size: 13px; margin-bottom: 20px; }

  media (max-width: 860px) {
    .cart-layout { grid-template-columns: 1fr; }
    .cart-summary-card { position: static; }
  }

  media (max-width: 560px) {
    .cart-item { flex-wrap: wrap; }
    .cart-item-subtotal { width: auto; margin-left: auto; }
  }
</style>

<div class="cart-wrap">
    <div class="cart-heading">Shopping Cart</div>
    <div class="cart-subtitle">@Model.TotalItems item(s) in your cart</div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="cart-layout">

            <div class="cart-items-card">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-item" data-product-id="@item.ProductId">
                        <div class="cart-item-thumb">
                            @if (!string.IsNullOrEmpty(item.ImgName))
                            {
                                <img src="~/ProductsImg/@item.ImgName" alt="@item.Title" />
                            }
                            else
                            {
                                <span>No image</span>
                            }
                        </div>

                        <div class="cart-item-info">
                            <div class="cart-item-title">@item.Title</div>
                            <div class="cart-item-price">@item.Price.ToString("N0") Toman each</div>
                            @if (!item.IsPresent)
                            {
                                <span class="cart-item-badge">Out of stock</span>
                            }
                        </div>

                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="qty-form">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <div class="cart-item-qty">
                                <button type="button" class="qty-minus">&minus;</button>
                                <input type="text" name="quantity" class="qty-value" value="@item.Quantity" readonly />
                                <button type="button" class="qty-plus">+</button>
                            </div>
                        </form>

                        <div class="cart-item-subtotal">@item.Subtotal.ToString("N0")</div>

                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="cart-item-remove">Remove</button>
                        </form>
                    </div>
                }
            </div>

            <div class="cart-summary-card">
                <h3>Order summary</h3>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span>@Model.Subtotal.ToString("N0") Toman</span>
                </div>
                <div class="summary-row">
                    <span>Shipping</span>
                    <span>@(Model.ShippingCost == 0 ? "Free" : Model.ShippingCost.ToString("N0") + " Toman")</span>
                </div>
                <div class="summary-row total">
                    <span>Total</span>
                    <span>@Model.Total.ToString("N0") Toman</span>
                </div>

                <a href="/Checkout/Index" class="checkout-btn">Proceed to checkout</a>
                <a href="/Product/Index" class="continue-link">Continue shopping</a>
            </div>

        </div>
    }
    else
    {
        <div class="empty-cart">
            <div class="icon">🛒</div>
            <h3>Your cart is empty</h3>
            <p>Looks like you haven't added anything yet.</p>
            <a href="/Product/Index" class="checkout-btn" style="display:inline-block; width:auto; padding:12px 28px;">Start shopping</a>
        </div>
    }
</div>

<script>
  document.querySelectorAll('.cart-item').forEach(item => {
    const minusBtn = item.querySelector('.qty-minus');
    const plusBtn = item.querySelector('.qty-plus');
    const qtyInput = item.querySelector('.qty-value');
    const form = item.querySelector('.qty-form');

    if (!minusBtn || !plusBtn || !qtyInput || !form) return;

    minusBtn.addEventListener('click', () => {
      let val = parseInt(qtyInput.value, 10) || 1;
      if (val > 1) {
        qtyInput.value = val - 1;
        form.submit();
      }
    });

    plusBtn.addEventListener('click', () => {
      let val = parseInt(qtyInput.value, 10) || 1;
      qtyInput.value = val + 1;
      form.submit();
    });
  });
</script>
