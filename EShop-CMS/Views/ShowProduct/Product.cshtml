@model EShop_CMS.DataBase.Model.Product
@{
    ViewData["Title"] = Model.Title;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title</title>
    <style>
            :root {
                --bg: #F7F8FA;
                --surface: #FFFFFF;
                --border: #E3E6EA;
                --text: #1B1F24;
                --muted: #6B7280;
                --accent: #2F6FED;
                --accent-dark: #1F4FBE;
                --accent-light: #EEF2FF;
                --ok-bg: #E7F6EC;
                --ok-text: #1E7A3C;
                --no-bg: #FCEAEA;
                --no-text: #B3261E;
                --radius: 14px;
                --shadow: 0 1px 2px rgba(16,24,40,0.06), 0 1px 3px rgba(16,24,40,0.08);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
                line-height: 1.5;
            }

            a {
                color: inherit;
            }

            .container {
                max-width: 1180px;
                margin: 0 auto;
                padding: 0 24px;
            }

            /* Header */
            .site-header {
                background: var(--surface);
                border-bottom: 1px solid var(--border);
                position: sticky;
                top: 0;
                z-index: 10;
            }

            .header-inner {
                display: flex;
                align-items: center;
                gap: 24px;
                padding: 16px 24px;
                max-width: 1180px;
                margin: 0 auto;
            }

            .logo {
                font-size: 20px;
                font-weight: 800;
                letter-spacing: -0.02em;
                text-decoration: none;
                white-space: nowrap;
            }

                .logo span {
                    color: var(--accent);
                }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 20px;
                margin-left: auto;
                font-size: 14px;
                font-weight: 500;
            }

                .header-actions a {
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }

            .cart-count {
                background: var(--accent);
                color: white;
                font-size: 11px;
                font-weight: 700;
                border-radius: 999px;
                padding: 1px 7px;
            }

            /* Breadcrumb */
            .breadcrumb {
                max-width: 1180px;
                margin: 20px auto 0 auto;
                padding: 0 24px;
                font-size: 13px;
                color: var(--muted);
            }

                .breadcrumb a {
                    text-decoration: none;
                    color: var(--muted);
                }

                    .breadcrumb a:hover {
                        color: var(--accent);
                    }

            /* Product section */
            .product-section {
                max-width: 1180px;
                margin: 0 auto;
                padding: 24px;
                display: grid;
                grid-template-columns: 460px 1fr;
                gap: 40px;
            }

            .product-image {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                height: 460px;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--muted);
                font-size: 13px;
            }

                .product-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .product-info {
                display: flex;
                flex-direction: column;
            }

            .badge {
                display: inline-block;
                align-self: flex-start;
                padding: 4px 12px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 600;
                margin-bottom: 14px;
            }

                .badge.ok {
                    background: var(--ok-bg);
                    color: var(--ok-text);
                }

                .badge.no {
                    background: var(--no-bg);
                    color: var(--no-text);
                }

            .product-title {
                font-size: 26px;
                font-weight: 800;
                margin-bottom: 10px;
                line-height: 1.3;
            }

            .product-price {
                font-size: 24px;
                font-weight: 800;
                color: var(--accent);
                margin-bottom: 20px;
            }

            .product-description {
                font-size: 14px;
                color: var(--muted);
                line-height: 1.7;
                margin-bottom: 28px;
                white-space: pre-line;
            }

            .qty-row {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 20px;
            }

            .qty-control {
                display: flex;
                align-items: center;
                border: 1px solid var(--border);
                border-radius: 8px;
                overflow: hidden;
            }

                .qty-control button {
                    width: 36px;
                    height: 38px;
                    border: none;
                    background: var(--surface);
                    font-size: 16px;
                    cursor: pointer;
                }

                    .qty-control button:hover {
                        background: var(--bg);
                    }

                .qty-control input {
                    width: 44px;
                    height: 38px;
                    text-align: center;
                    border: none;
                    border-left: 1px solid var(--border);
                    border-right: 1px solid var(--border);
                    font-size: 14px;
                }

            .action-row {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
            }

            .btn-primary {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                background: var(--accent);
                color: white;
                border: none;
                text-decoration: none;
                border-radius: 8px;
                padding: 13px 28px;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
            }

                .btn-primary:hover {
                    background: var(--accent-dark);
                }

                .btn-primary.disabled {
                    background: var(--border);
                    color: var(--muted);
                    cursor: not-allowed;
                    pointer-events: none;
                }

            .btn-outline {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                background: var(--surface);
                color: var(--text);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 13px 20px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
            }

                .btn-outline:hover {
                    background: var(--bg);
                }

            .perks-strip {
                margin-top: 28px;
                padding-top: 24px;
                border-top: 1px solid var(--border);
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .perk-item {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 13px;
                color: var(--muted);
            }

                .perk-item .perk-icon {
                    font-size: 16px;
                }

            /* Category info card */
            .meta-card {
                margin-top: 24px;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 14px 16px;
                font-size: 13px;
                color: var(--muted);
            }

                .meta-card a {
                    color: var(--accent);
                    font-weight: 600;
                    text-decoration: none;
                }

                    .meta-card a:hover {
                        text-decoration: underline;
                    }

            @@media (max-width: 860px) {
                .product-section {
                    grid-template-columns: 1fr;
                }

                .product-image {
                    height: 320px;
                }
            }

            @@media (max-width: 480px) {
                .header-inner {
                    padding: 12px 16px;
                }

                .product-section {
                    padding: 16px;
                }

                .product-title {
                    font-size: 21px;
                }

                .product-price {
                    font-size: 20px;
                }

                .action-row {
                    flex-direction: column;
                    align-items: stretch;
                }

                .action-row .btn-primary,
                .action-row .btn-outline,
                .action-row form {
                    width: 100%;
                }
            }
    </style>
</head>
<body>


    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a href="/">Home</a>
        @if (Model.group != null)
        {
            <span> / </span>
            <a>@Model.group.GroupTitle</a>
        }
        <span> / </span>
        <span>@Model.Title</span>
    </div>

    <!-- Product -->
    <section class="product-section">

        <div class="product-image">
            @if (!string.IsNullOrEmpty(Model.ImgName))
            {
                <img src="~/ProductsImg/@Model.ImgName" alt="@Model.Title" />
            }
            else
            {
                <span>No image</span>
            }
        </div>

        <div class="product-info">

            @if (Model.IsPresent)
            {
                <span class="badge ok">In stock</span>
            }
            else
            {
                <span class="badge no">Out of stock</span>
            }

            <h1 class="product-title">@Model.Title</h1>
            <div class="product-price">@Model.Price.ToString("N0") Toman</div>

            <p class="product-description">@Model.Description</p>

            @if (Model.IsPresent)
            {
                <div class="qty-row">
                    <span style="font-size:13px; font-weight:600;">Quantity</span>
                    <div class="qty-control">
                        <button type="button" id="qtyMinus">&minus;</button>
                        <input type="text" id="qtyInput" value="1" readonly>
                        <button type="button" id="qtyPlus">+</button>
                    </div>
                </div>

                <div class="action-row">
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="quantity" id="quantityHidden" value="1" />
                        <button type="submit" class="btn-primary">🛒 Add to cart</button>
                    </form>
                    <a asp-controller="Home" asp-action="Index" class="btn-outline">Continue shopping</a>
                </div>
            }
            else
            {
                <div class="action-row">
                    <span class="btn-primary disabled">Currently unavailable</span>
                    <a href="/Product/Index" class="btn-outline">Browse similar products</a>
                </div>
            }

            <div class="perks-strip">
                <div class="perk-item"><span class="perk-icon">🚚</span> Free shipping on orders over 50$</div>
                <div class="perk-item"><span class="perk-icon">↩️</span> 7-day return policy</div>
                <div class="perk-item"><span class="perk-icon">🔒</span> Secure checkout</div>
            </div>

            @if (Model.group != null)
            {
                <div class="meta-card">
                    Category: <a>@Model.group.GroupTitle</a>
                </div>
            }

        </div>

    </section>

    <script>
            const qtyInput = document.getElementById('qtyInput');
            const quantityHidden = document.getElementById('quantityHidden');
            const minusBtn = document.getElementById('qtyMinus');
            const plusBtn = document.getElementById('qtyPlus');

            function syncHidden() {
              if (quantityHidden) quantityHidden.value = qtyInput.value;
            }

            if (minusBtn && plusBtn && qtyInput) {
              minusBtn.addEventListener('click', () => {
                let val = parseInt(qtyInput.value, 10) || 1;
                if (val > 1) qtyInput.value = val - 1;
                syncHidden();
              });

              plusBtn.addEventListener('click', () => {
                let val = parseInt(qtyInput.value, 10) || 1;
                qtyInput.value = val + 1;
                syncHidden();
              });
            }
    </script>

</body>
</html>
